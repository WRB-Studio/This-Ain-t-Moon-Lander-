  "entries": [
    {
      "key": "game.a.full.tank.i.ll.have.a.word.with.accounting.the.missing.pilot.ca",
      "text": "A full tank? I'll have a word with accounting. The missing pilot can wait."
    },
    {
      "key": "game.all.right.i.ll.take.it",
      "text": "All right. I'll take it."
    },
    {
      "key": "game.am.i.supposed.to.fix.this.now",
      "text": "Am I supposed to fix this now?"
    },
    {
      "key": "game.another.one",
      "text": "Another one."
    },
    {
      "key": "game.another.pad.same.procedure",
      "text": "Another pad. Same procedure."
    },
    {
      "key": "game.another.parking.spot.awaits.your.grand.entrance",
      "text": "Another parking spot awaits your grand entrance."
    },
    {
      "key": "game.any.progress.the.parking.situation.is.excellent.right.microphone",
      "text": "'Any progress?'\n'The parking situation is excellent.'\nRight. Microphone off."
    },
    {
      "key": "game.as.if.i.d.let.you.fly.that.thing.to.the.moon.again",
      "text": "As if I'd let you fly that thing to the Moon again."
    },
    {
      "key": "game.audio.only",
      "text": "AUDIO\nONLY"
    },
    {
      "key": "game.back.in.one.piece.with.the.company.lander.excellent.work.by.show",
      "text": "Back in one piece. With the company lander.\nExcellent work.\n\nBy 'show some initiative', I did not mean\nan unauthorized Moon trip on company fuel.\n\nStill. The ship is back.\nI'll keep the report suitably vague."
    },
    {
      "key": "game.before.we.get.to.the.coordinates.take.this.radio.messages.optiona",
      "text": "Before we get to the coordinates: take this radio.\n\nMessages, optional video, signal tracking. It even keeps the old messages.\n\nPlease take it. Our last pilot was difficult to reach."
    },
    {
      "key": "game.bring.it.down.preferably.in.one.piece",
      "text": "Bring it down. Preferably in one piece."
    },
    {
      "key": "game.close",
      "text": "CLOSE"
    },
    {
      "key": "game.coffee.please.it.s.been.nothing.but.parking.all.day.wait.is.this",
      "text": "'Coffee?'\n'Please. It's been nothing but parking all day.'\nWait. Is this still broadcasting?"
    },
    {
      "key": "game.concourse",
      "text": "CONCOURSE"
    },
    {
      "key": "game.continue",
