      "key": "game.there.was.nobody.there.to.ask",
      "text": "There was nobody there to ask."
    },
    {
      "key": "game.there.you.are.welcome.to.the.station.we.were.expecting.that.lande",
      "text": "There you are. Welcome to the station.\nWe were expecting that lander.\n\nUse either landing pad.\nKeep it upright, please.\nOur maintenance crew has had\na very long day."
    },
    {
      "key": "game.those.parcels.have.been.waiting.longer.than.i.have",
      "text": "Those parcels have been waiting longer than I have."
