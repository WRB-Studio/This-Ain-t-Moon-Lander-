      "key": "game.next",
      "text": "NEXT"
    },
    {
      "key": "game.next.level",
      "text": "Next Level"
    },
    {
      "key": "game.nine.levels.i.gave.you.a.sky.a.spacecraft.thrusters.and.you.keep",
      "text": "NINE LEVELS!\nI gave you a sky!\nA spacecraft! Thrusters!\nAnd you keep opening\none parking spot after another!\n\nFULL TANK. FLY UP. KEEP GOING.\nI don't know how to make\nthis any clearer!\n\nYou know what? Do whatever you want.\nLand another hundred times.\nGive the pads names. I'm out."
    },
    {
      "key": "game.no.promises",
      "text": "No promises."
    },
    {
      "key": "game.no.thanks.i.don.t.need.a.radio",
      "text": "No thanks. I don't need a radio."
    },
    {
      "key": "game.no.i.am.not.commenting.on.this",
      "text": "No. I am not commenting on this."
    },
    {
      "key": "game.noted.i.ll.put.that.under.courier.comments",
      "text": "Noted. I'll put that under 'courier comments'."
    },
    {
      "key": "game.of.course.nobody.told.you.communication.is.more.of.a.decorative.c",
      "text": "Of course nobody told you. Communication is more of a decorative concept at that company."
    },
    {
      "key": "game.of.course",
      "text": "Of course."
    },
    {
      "key": "game.of.course.i.ll.record.accepted.reluctantly.here.you.go.refusing.e",
      "text": "Of course. I'll record 'accepted reluctantly'. Here you go. Refusing equipment requires a radio to submit the refusal."
    },
    {
      "key": "game.oh.you.re.actually.trying.something.else.and.gravity.has.stopped",
      "text": "Oh. You're actually trying something else.\n\nAnd gravity has stopped participating.\nI hadn't planned for that."
    },
    {
      "key": "game.oh.so.that.is.the.moon.minor.naming.issue",
      "text": "Oh.\nSo THAT is the Moon.\nMinor naming issue."
    },
    {
      "key": "game.on.the.moon.well.at.least.we.know.where.our.pilot.parked",
      "text": "On the Moon. Well. At least we know where our pilot parked."
    },
