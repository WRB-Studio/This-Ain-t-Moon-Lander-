      "key": "game.enter.station",
      "text": "Enter Station"
    },
    {
      "key": "game.excellent.a.confirmed.receipt.my.favourite.kind.of.adventure",
      "text": "Excellent. A confirmed receipt. My favourite kind of adventure."
    },
    {
      "key": "game.excellent.one.radio.issued.try.to.return.with.the.same.number.of",
      "text": "Excellent. One radio issued. Try to return with the same number of radios."
    },
    {
      "key": "game.exit.lander",
      "text": "Exit Lander"
    },
    {
      "key": "game.exit.station",
      "text": "Exit Station"
    },
    {
      "key": "game.exterior.deck",
      "text": "Exterior Deck"
    },
    {
      "key": "game.finally.the.company.lander.parked.on.the.moon.with.a.full.tank.i",
      "text": "Finally. The company lander.\n\nParked on the Moon with a full tank.\nI'll have a word with accounting.\n\nBring it back to Earth in one piece.\nInsurance doesn't cover\n'forgotten on the Moon'."
    },
    {
      "key": "game.good.third.level.you.understand.how.a.landing.pad.works.i.was.hop",
      "text": "Good. Third level.\nYou understand how a landing pad works.\n\nI was hoping for a little more\ninitiative after the introduction.\nBut fine. Another pad.\n\nDon't let me interrupt your parking."
    },
    {
      "key": "game.has.anyone.told.them.they.can.leave.i.did.several.times.oh.you.ca",
      "text": "'Has anyone told them they can leave?'\n'I did. Several times.'\nOh. You can hear us."
    },
    {
      "key": "game.here.is.a.little.message.for.you",
      "text": "Here is a little message for you!"
    },
    {
      "key": "game.here.is.a.little.message.text.for.you",
      "text": "Here is a little message text for you!"
    },
    {
      "key": "game.how.surprising",
      "text": "How surprising."
    },
    {
      "key": "game.i.am.no.longer.counting.enthusiastically",
      "text": "I am no longer counting enthusiastically."
    },
    {
      "key": "game.i.briefly.hoped.you.would.surprise.me",
      "text": "I briefly hoped you would surprise me."
    },
    {
      "key": "game.i.only.found.the.ship",
      "text": "I only found the ship."
    },
    {
      "key": "game.i.specifically.told.you.that.you.can.fly.up",
      "text": "I specifically told you that you can fly up."
    },
    {
      "key": "game.i.would.sigh.but.this.is.text",
      "text": "I would sigh, but this is text."
    },
    {
      "key": "game.if.it.rattles.it.was.doing.that.before",
      "text": "If it rattles, it was doing that before."
    },
    {
      "key": "game.if.this.is.about.the.delivery.please.do.not.give.it.to.me",
      "text": "If this is about the delivery, please do not give it to me."
    },
    {
      "key": "game.i.ll.take.a.look",
      "text": "I'll take a look."
    },
    {
      "key": "game.i.m.not.here",
      "text": "I'm not here."
    },
    {
      "key": "game.i.m.not.your.courier",
      "text": "I'm not your courier."
    },
    {
      "key": "game.incoming.transmission.you.re.late.wait.you.re.not.our.pilot.where",
      "text": "INCOMING TRANSMISSION\n\nYou're late.\n\n...Wait. You're not our pilot.\nWhere did you get that ship?"
    },
    {
      "key": "game.is.that.pilot.still.landing.yes.don.t.ask.oh.the.microphone.is.on",
      "text": "'Is that pilot still landing?'\n'Yes. Don't ask.'\nOh. The microphone is on."
    },
    {
      "key": "game.it.was.parked.on.the.moon",
      "text": "It was parked on the Moon."
    },
    {
      "key": "game.keep.the.spacecraft.upright.aim.for.the.pad",
      "text": "Keep the spacecraft upright. Aim for the pad."
    },
    {
      "key": "game.land.if.you.must.i.am.past.negotiating",
      "text": "Land if you must. I am past negotiating."
    },
