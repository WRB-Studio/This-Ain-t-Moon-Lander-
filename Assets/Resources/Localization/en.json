      "text": "CREW QUARTERS"
    },
    {
      "key": "game.did.you.bring.the.delivery.we.were.expecting.that.ship.yesterday",
      "text": "Did you bring the delivery?\nWe were expecting that ship yesterday."
    },
    {
      "key": "game.docking.confirmed.you.can.step.outside",
      "text": "Docking confirmed.\nYou can step outside."
    },
