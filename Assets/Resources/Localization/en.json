      "key": "game.that.s.inconvenient.people.are.usually.our.best.source.of.excuses",
      "text": "That's inconvenient. People are usually our best source of excuses."
    },
    {
      "key": "game.the.cargo.compartment.was.opened.after.that.the.log.goes.quiet.i",
      "text": "The cargo compartment was opened.\nAfter that, the log goes quiet.\n\nI have the last confirmed pickup location."
    },
    {
      "key": "game.the.coordinates.are.in.a.message.on.your.new.radio.open.radio.and",
      "text": "The coordinates are in a message on your new radio.\n\nOpen RADIO and select 'Track signal' when you're ready.\n\nMaintenance has topped up your tank.\n\nFor now I'll write: 'Ship returned. Rest unclear.'\n\nThat holds up surprisingly well."
    },
    {
      "key": "game.the.corridor.is.free.the.paperwork.is.not",
      "text": "The corridor is free. The paperwork is not."
    },
    {
      "key": "game.the.lander.is.back.finally",
      "text": "The lander is back. Finally."
    },
    {
      "key": "game.the.moon.full.tank.no.pilot",
      "text": "The Moon. Full tank, no pilot."
    },
    {
      "key": "game.the.pickup.coordinates.are.still.on.your.radio.open.radio.to.read",
      "text": "The pickup coordinates are still on your radio.\n\nOpen RADIO to read the message or track the signal.\n\nInvestigate, go home, or enjoy the corridor. I have plenty of forms to keep me company."
    },
    {
      "key": "game.the.replacement.pilot.take.a.seat.or.stand.the.chair.is.being.rep",
      "text": "The replacement pilot?\nTake a seat. Or stand. The chair is being repaired."
