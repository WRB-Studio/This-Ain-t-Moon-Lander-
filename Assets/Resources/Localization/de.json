    {
      "key": "cargo.dialog.discovery.1",
      "text": "Ich bin Rhekk – Passagier, kein Paket.\nDie Beschriftung war offenbar zu subtil."
    },
    {
      "key": "cargo.dialog.discovery.2",
      "text": "Der Pilot wollte kurz zur Anlage hinter dem Außenposten.\nSeine fünf Minuten dauern erstaunlich lange."
    },
    {
      "key": "cargo.dialog.discovery.3",
      "text": "Das Schiff ist ohne ihn gestartet.\nSeitdem habe ich vom Piloten nichts gehört."
    },
    {
      "key": "cargo.dialog.discovery.4",
      "text": "Die Kapsel bleibt zu, bis das Stationsdock den Druck ausgleicht.\nVERBINDEN drücken, das freie Stahlseilende zum Schiff tragen und unten FESTMACHEN."
    },
    {
      "key": "cargo.dialog.discovery.5",
      "text": "Setz mich langsam auf der markierten Ablage neben den Stationspads ab; sobald ich ruhig stehe, löst sich das Seil.\nDann landest du und öffnest die Kapsel."
    },
    {
      "key": "cargo.dialog.repeat",
      "text": "VERBINDEN, Seil zum Schiff tragen, unten FESTMACHEN und einsteigen.\nAn der Station sanft absetzen, warten, dann selbst landen und die Kapsel öffnen."
    },
    {
      "key": "cargo.dialog.release.1",
      "text": "Danke, dass du mich hergebracht hast.\nMeine Organe hätten einen ruhigeren Flug bevorzugt."
    },
    {
      "key": "cargo.dialog.release.2",
      "text": "Ich gehe zur Registrierung: meinen Status von Fracht auf Person ändern.\nDanach reden wir über den Piloten und das Schiff, das ohne ihn startet."
    },
    {
      "key": "cargo.dialog.release.3",
      "text": "Falls sie mich wieder einpacken, klopfe ich.\nDu kennst das Geräusch."
    },
