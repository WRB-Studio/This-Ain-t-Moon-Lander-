    de: Rhekk
    en: Rhekk
  - key: story.character.training-pilot
    de: "Flugtrainer \xB7 Testpilot a. D."
    en: "Flight instructor \xB7 former test pilot"
  - key: game.continue
    de: Weiter
    en: Continue
