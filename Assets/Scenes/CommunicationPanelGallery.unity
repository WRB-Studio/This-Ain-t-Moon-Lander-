  cases:
  - title: 'Weiter-Ansicht: TrainingBriefing + StoryDialog'
    group: "Gespr\xE4ch\ngemeinsames DialogueContent-Prefab"
    focus: {x: 0, y: 0.95604396}
    purpose: Tutorial und kurze Storymeldungen mit Best\xE4tigung.
    sourcePrefab: Assets/Prefabs/UI/TrainingBriefing.prefab + UI/StoryDialog.prefab
    comparison: Gemeinsames DialogueContent-Prefab; TrainingBriefing und StoryDialog
      steuern den Ablauf.
    root: {fileID: 0}
    texts:
    - label: {fileID: 0}
      german: "Flugtrainer \xB7 Testpilot a. D."
      english: "Flight instructor \xB7 former test pilot"
    - label: {fileID: 0}
      german: "Ziel: sicher auf dem Pad landen.\n\nGedr\xFCckt halten: Schub.\nZur
        Seite ziehen: drehen."
      english: 'Goal: land safely on the pad.


        Hold: thrust.

        Drag
        sideways: turn.'
    - label: {fileID: 0}
      german: 
      english: 
    - label: {fileID: 0}
      german: Weiter
      english: Continue
