  - title: 'Antwort-Ansicht: StoryDialog'
    group: "Gespr\xE4ch\ngemeinsames DialogueContent-Prefab"
    focus: {x: 0, y: 0.47802198}
    purpose: 'Registrierung und Rhekk: kurzer Text mit Entscheidungen.'
    sourcePrefab: Assets/Prefabs/UI/StoryDialog.prefab
    comparison: "Antwortbereich bleibt eigene Variante; Portr\xE4t optional, aktuell
      nicht zugewiesen."
    root: {fileID: 0}
    texts:
    - label: {fileID: 0}
      german: Rhekk
      english: Rhekk
    - label: {fileID: 0}
      german: 'Da ist er: der Mond.

        Brems rechtzeitig.'
      english: 'There it is: the Moon.

        Brake in time.'
    - label: {fileID: 0}
      german: Endlich. Ich war schon kurz davor, Inventar zu werden.
      english: Finally. I was about to become inventory.
    - label: {fileID: 0}
      german: Weiter
      english: Continue
    - label: {fileID: 0}
      german: Was ist passiert?
      english: What happened?
    - label: {fileID: 0}
      german: Wie bekomme ich dich hier weg?
      english: How do I get you out of here?
    - label: {fileID: 0}
      german: "Ich komme gleich zur\xFCck."
      english: I'll be right back.
    - label: {fileID: 0}
      german: 
      english: 
    - label: {fileID: 0}
      german: 
      english: 
    - label: {fileID: 0}
      german: 
      english: 
