  - title: Kurzer Nebentext
    group: Kurztext
    focus: {x: 0.6666667, y: 0.95604396}
    purpose: Kommentare bei etwa einem Drittel von oben; unterbrechen das Spiel nicht.
    sourcePrefab: Assets/Prefabs/UI/SpaceFlightNavigation.prefab
    comparison: Gemeinsame ShortCaption-Gestaltung; bildschirmfester Nebentext.
    root: {fileID: 0}
    texts:
    - label: {fileID: 7687293499074866766}
      german: "Hier war wirklich schon jemand.\nHoffentlich mit R\xFCckflugticket."
      english: 'Someone really was here before.

        Hopefully with a return
        ticket.'
    demoButtons: []
