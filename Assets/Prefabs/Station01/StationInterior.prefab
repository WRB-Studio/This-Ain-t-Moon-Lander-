--- !u!114 &560000003
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 560000000}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f7597317b9ae410682ef6789c469ba43, type: 3}
  m_Name:
  m_EditorClassIdentifier:
  speaker: Registration
  steps:
  - message: "The replacement pilot?\nTake a seat. Or stand. The chair is being repaired."
    answers:
    - text: "I only found the ship."
      reaction: "Then you're the replacement finder. Close enough."
    - text: "Who were you expecting?"
      reaction: "Someone with that lander. You meet half the requirements."
  - message: "Where did you get the ship?"
    answers:
    - text: "It was parked on the Moon."
      reaction: "On the Moon. Well. At least we know where our pilot parked."
    - text: "The Moon. Full tank, no pilot."
      reaction: "A full tank? I'll have a word with accounting. The missing pilot can wait."
  - message: "Did you bring the delivery?\nWe were expecting that ship yesterday."
    answers:
    - text: "What delivery?"
      reaction: "Of course nobody told you. Communication is more of a decorative concept at that company."
    - text: "There was nobody there to ask."
      reaction: "That's inconvenient. People are usually our best source of excuses."
  - message: "The cargo compartment was opened.\nAfter that, the log goes quiet.\n\nI have the last confirmed pickup location."
    answers:
    - text: "Send me the coordinates."
      reaction: "Done. No heroic speeches required."
    - text: "Am I supposed to fix this now?"
      reaction: "Supposed to? No. You just happen to have the ship and very little supervision."
  - message: "The coordinates are on your radio.\nMaintenance has topped up your tank.\n\nTake a look if you like. For now I'll write:\n'Ship returned. Rest unclear.'\nThat holds up surprisingly well."
    answers:
    - text: "I'll take a look."
      reaction: ""
    - text: "No promises."
      reaction: ""
  repeatMessage: "The pickup coordinates are still on your radio.\n\nInvestigate, go home, or enjoy the corridor.\nI have plenty of forms to keep me company."
  goodbyeAnswer: "Thanks. I will take a look."
